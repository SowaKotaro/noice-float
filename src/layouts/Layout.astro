---
import { ClientRouter } from "astro:transitions";
import SiteHeader from "../components/SiteHeader.astro";
import { SITE_DESCRIPTION, SITE_LOCALE, SITE_NAME, absolute } from "../lib/site";
import "../styles/global.css";

interface Props {
  /** `<title>` に入れる完成済みの文字列（組み立ては `pageTitle()` を使う）。 */
  title: string;
  /** ページ固有の要約。**全ページ同じ文言にしないこと**（重複と判定される）。 */
  description?: string;
  /** OGP 画像のパス（サイト内相対）。語ページはビルド生成の PNG を渡す。 */
  ogImage?: string;
  /** OGP の種別。語ページは記事扱いにしておく。 */
  ogType?: "website" | "article";
  /** JSON-LD。`@graph` にまとめて 1 つの script として出す。 */
  jsonLd?: Record<string, unknown>[];
  /** 404 など、インデックスさせたくないページ用。 */
  noindex?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  ogImage = "/og/default.png",
  ogType = "website",
  jsonLd = [],
  noindex = false,
} = Astro.props;

// canonical は「今のページの絶対 URL」。クエリや index.html を落とすため
// Astro.url ではなく pathname だけを site に載せ直している。
const canonical = absolute(Astro.url.pathname, Astro.site);
const ogImageUrl = absolute(ogImage, Astro.site);

const graph =
  jsonLd.length > 0
    ? { "@context": "https://schema.org", "@graph": jsonLd }
    : null;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#FFFDF7" />
    <meta name="color-scheme" content="light" />

    {/* ロゴはトップの LCP 要素。1.9KB なので先に取りに行かせる
        （`font-display: block` にしてあるぶん、遅れると空白の時間が延びる）。 */}
    <link
      rel="preload"
      href="/fonts/dela-gothic-one-logo.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={SITE_LOCALE} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_NAME}
      href={absolute("/rss.xml", Astro.site)}
    />

    {
      graph && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(graph)}
        />
      )
    }

    <ClientRouter />
  </head>
  <body class="min-h-screen">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[100] focus:border-4 focus:border-black focus:bg-white focus:px-3 focus:py-2 focus:font-black"
    >
      本文へスキップ
    </a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
  </body>
</html>
